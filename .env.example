# Ambiente geral
NODE_ENV=development

# URLs locais
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# API
API_PORT=3000

# Banco de dados futuro
# Nunca coloque senha real no .env.example.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fasttrack

# Sessao/autenticacao futura
SESSION_SECRET=troque-este-valor

# TOKEN futuro
MERCADO_PAGO_ACCESS_TOKEN=coloque-o-token-real-apenas-no-env-local
